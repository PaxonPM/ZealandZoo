@page
@model ZealandZoo.Pages.KalenderModel
@{
    ViewData["Title"] = "Home Page";
}
@{
    var today = DateTime.Now;
    int year = today.Year;
    int month = today.Month;

    int daysInMonth = DateTime.DaysInMonth(year, month);

    var firstDay = new DateTime(year, month, 1);

    // Mandag = 0
    int startDay = ((int)firstDay.DayOfWeek + 6) % 7;

    // Demo data (kan senere komme fra database)
    var data = new Dictionary<int, dynamic>
    {

    };


    
}

@functions {
    public double TimeToPercent(string time)
    {
        var parts = time.Split(':');
        int h = int.Parse(parts[0]);
        int m = int.Parse(parts[1]);

        return ((h * 60 + m) / (24.0 * 60)) * 100;
    }
}

<!DOCTYPE html>
<html lang="da">
<head>
    <h1> <form method="get" asp-page="/Åbningstider"><button type="submit" class="btn btn primary">Åbningstider</button></form></h1>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #111;
            color: white;
        }

        .calendar {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 10px;
        }

        .day {
            background: #1c1c1c;
            border-radius: 10px;
            padding: 5px;
            height: 220px;
            position: relative;
            overflow: hidden;
        }

        .day-number {
            font-size: 14px;
            font-weight: bold;
        }

        .timeline {
            position: relative;
            height: 180px;
            margin-top: 5px;
            border-top: 1px solid #333;
        }

        .block {
            position: absolute;
            left: 5px;
            right: 5px;
            border-radius: 6px;
            padding: 2px 4px;
            font-size: 10px;
            overflow: hidden;
        }

        .opening {
            background: #39ff14;
            color: black;
        }

        .event {
            background: #ff2da6;
            color: white;
        }
    </style>
</head>

<body>

    <div class="container mt-4">
        <h2>Månedskalender (@month/@year)</h2>

        <div class="calendar">

            @* Tomme felter før start *@
            @for (int i = 0; i < startDay; i++)
            {
                <div></div>
            }

            @* Dage *@
            @for (int day = 1; day <= daysInMonth; day++)
            {
                <div class="day @(day == today.Day ? "border border-success" : "")">

                    <div class="day-number">@day</div>

                    <div class="timeline">

                        @if (data.ContainsKey(day))
                        {
                            var d = data[day];

                            // Åbningstider
                            foreach (var o in d.openings)
                            {
                                var top = TimeToPercent(o.start);
                                var height = TimeToPercent(o.end) - top;

                                <div class="block opening"
                                     style="top:@top%; height:@height%">
                                    Åbning<br>@o.start - @o.end
                                </div>
                            }

                            // Events
                            foreach (var e in d.events)
                            {
                                var top = TimeToPercent(e.start);
                                var height = TimeToPercent(e.end) - top;

                                <div class="block event"
                                     style="top:@top%; height:@height%">
                                    @e.title<br>@e.start - @e.end
                                </div>
                            }
                        }

                    </div>
                </div>
            }

        </div>
    </div>

</body>
</html>