@page
@using ZooApp.Domain.Models
@model ZooApp.Web.Pages.Inventory.InventoryModel

@{
    string GetCategoryName(int id) => id switch
    {
        1 => "Softdrinks",
        2 => "Beers",
        3 => "Snacks",
        _ => $"Kategori {id}"
    };
}

<h1>Lageroversigt</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input asp-for="SearchName" class="form-control" placeholder="Søg efter vare..." />
    </div>
    <div class="col-md-4">
        <select asp-for="SortOrder" class="form-select">
            <option value="name_asc">Navn (A-Z)</option>
            <option value="name_desc">Navn (Z-A)</option>
            <option value="quantity_asc">Antal (stigende)</option>
            <option value="quantity_desc">Antal (faldende)</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Søg</button>
    </div>
</form>

<a asp-page="/Create" class="btn btn-success mb-3">Tilføj ny vare</a>

@foreach (var group in Model.Items.GroupBy(i => i.CategoryId))
{
    <h4 class="mt-4">@GetCategoryName(group.Key)</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Navn</th>
                <th>Antal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in group)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Quantity</td>
                    <td>
                        <a asp-page="/Inventory/EditItem" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Rediger</a>
                        <form method="post" asp-page="/Inventory/DeleteItem" asp-route-id="@item.Id" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Er du sikker på du vil slette @item.Name?')">Slet</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}