@page
@using ZooApp.Domain.Models
@model ZooApp.Web.Pages.Inventory.InventoryModel

<h1>Lageroversigt</h1>
<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Category</th>
            <th>Name</th>
            <th>Quantity</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.CategoryId</td>
                <td>@item.Name</td>
                <td>@item.Quantity</td>
                <td><a asp-page="/Inventory/EditItem" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Rediger</a></td>
            </tr>
        }
    </tbody>
</table>