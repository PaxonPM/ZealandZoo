@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
    bool isCalendar = Model.View == "calendar";
    var today = DateTime.Today;
    int year = today.Year;
    int month = today.Month;
    int daysInMonth = DateTime.DaysInMonth(year, month);
    int firstDayOfWeek = ((int)new DateTime(year, month, 1).DayOfWeek + 6) % 7; // Monday = 0
    bool isGuest = Model.HttpContext.Session.GetString("IsGuest") == "true";
    bool isAdmin = Model.HttpContext.Session.GetString("IsAdmin") == "true";
}

<h2>Åbningstider</h2>
<table class="table">
    <thead>
        <tr>
            <th>Dag</th>
            <th>Åbningstid</th>
            <th>Lukketid</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var å in Model.ÅbningsTider)
        {
            <tr>
                <td>@å.DayOfWeek</td>
                <td>@å.OpenTime</td>
                <td>@å.CloseTime</td>
            </tr>
        }
    </tbody>
</table>

<h2>Events</h2>
<div class="mb-3 d-flex justify-content-between align-items-center">
    @if (isAdmin)
    {
        <a class="btn btn-primary" asp-page="/Event/CreateEvent">Opret nyt Event</a>
    }
    else
    {
        <span></span>
    }
    <div>
        <a class="btn btn-outline-secondary @(!isCalendar ? "active" : "")" asp-page="/Index" asp-route-view="list">Liste</a>
        <a class="btn btn-outline-secondary @(isCalendar ? "active" : "")" asp-page="/Index" asp-route-view="calendar">Kalender</a>
    </div>
</div>


@if (!isCalendar)
{
    @if (Model.SuccessMessage != null)
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.Events.Count == 0)
    {
        <p>Der findes ingen events.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var ev in Model.Events)
            {
                bool isSignedUp = Model.UserSignUps.ContainsKey(ev.Id) && Model.UserSignUps[ev.Id];
                bool isFull = ev.CurrentParticipants >= ev.MaxParticipants;

                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header fw-semibold fs-5">@ev.Title</div>
                        <div class="card-body">
                            <ul class="list-unstyled mb-0">
                                <li><i class="bi bi-calendar-event me-2"></i><strong>Start:</strong> @ev.StartDateTime.ToString("dd-MM-yyyy HH:mm")</li>
                                <li><i class="bi bi-calendar-x me-2"></i><strong>Slut:</strong> @ev.EndDateTime.ToString("dd-MM-yyyy HH:mm")</li>
                                <li><i class="bi bi-geo-alt me-2"></i><strong>Lokation:</strong> @ev.Location</li>
                                <li>
                                    <i class="bi bi-people me-2"></i><strong>Deltagere:</strong>
                                    <span class="badge @(isFull ? "bg-danger" : "bg-success")">
                                        @ev.CurrentParticipants / @ev.MaxParticipants
                                    </span>
                                </li>
                            </ul>
                        </div>
                        <div class="card-footer">
                            @if (isGuest)
                            {
                                @if (isSignedUp)
                                {
                                    <form method="post" asp-page-handler="CancelSignUp">
                                        <input type="hidden" name="eventId" value="@ev.Id" />
                                        <button class="btn btn-danger w-100">Afmeld</button>
                                    </form>
                                }
                                else if (isFull)
                                {
                                    <button class="btn btn-secondary w-100" disabled>Fuldt booket</button>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="SignUp">
                                        <input type="hidden" name="eventId" value="@ev.Id" />
                                        <button class="btn btn-primary w-100">Tilmeld</button>
                                    </form>
                                }
                            }
                            else if (isFull)
                            {
                                <button class="btn btn-secondary w-100" disabled>Fuldt booket</button>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary w-100" disabled>Log ind for at tilmelde</button>
                            }
                            @if (isAdmin)
                            {
                                <a class="btn btn-warning btn-sm mt-2"
                                   asp-page="/Event/UpdateEvent"
                                   asp-route-id="@ev.Id">
                                    Update
                                </a>
                                <a class="btn btn-danger btn-sm mt-2"
                                   asp-page="/Event/DeleteEvent"
                                   asp-route-id="@ev.Id">
                                    Delete
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    <h5 class="mb-3">@((new DateTime(year, month, 1)).ToString("MMMM yyyy"))</h5>
    <table class="table table-bordered text-center" style="table-layout: fixed; width: 100%;">
        <thead>
            <tr>
                <th>Man</th><th>Tir</th><th>Ons</th><th>Tor</th><th>Fre</th><th>Lør</th><th>Søn</th>
            </tr>
        </thead>
        <tbody>
            @{
                int cell = 0;
                int totalCells = firstDayOfWeek + daysInMonth;
                int rows = (int)Math.Ceiling(totalCells / 7.0);
            }
            @for (int row = 0; row < rows; row++)
            {
                <tr>
                    @for (int col = 0; col < 7; col++)
                    {
                        int dayNumber = row * 7 + col - firstDayOfWeek + 1;
                        if (dayNumber < 1 || dayNumber > daysInMonth)
                        {
                            <td style="height: 100px;"></td>
                        }
                        else
                        {
                            var dayEvents = Model.Events.Where(e => e.StartDateTime.Date == new DateTime(year, month, dayNumber)).ToList();
                            <td class="@(dayNumber == today.Day ? "table-warning" : "")" style="height: 100px; vertical-align: top; padding: 6px; word-wrap: break-word; overflow: hidden;">
                                <strong>@dayNumber</strong>
                                @foreach (var ev in dayEvents)
                                {
                                    <div><small class="badge bg-primary text-wrap">@ev.StartDateTime.ToString("HH:mm") @ev.Title</small></div>
                                }
                            </td>
                        }
                    }
                </tr>
            }
        </tbody>
    </table>
}


