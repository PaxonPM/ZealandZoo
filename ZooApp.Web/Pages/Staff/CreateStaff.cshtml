@page
@model ZooApp.Web.Pages.CreateUser.CreateUserModel
@{
	ViewData["Id"] = "Create User";
}


<div class="container mt-4" style="max-width: 480px;">
	<h1>Lav ny medarbejder</h1>
	<form method="post">
		<div asp-validation-summary="ModelOnly" class="text-danger"></div>

		<div class="form-group">
			<label asp-for="@Model.NewUser.Name" class="control-label">Navn</label>
			<input asp-for="@Model.NewUser.Name" class="form-control" type="text" />
			<span asp-validation-for="@Model.NewUser.Name" class="text-danger"></span>
		</div>

		<div class="form-group">
			<label asp-for="@Model.NewUser.Email" class="control-label">Email</label>
			<input asp-for="@Model.NewUser.Email" class="form-control" type="email" />
			<span asp-validation-for="@Model.NewUser.Email" class="text-danger"></span>
		</div>

		<div class="form-group">
			<label asp-for="@Model.NewUser.Telefon" class="control-label">Telefon</label>
			<input asp-for="@Model.NewUser.Telefon" class="form-control" type="tel" />
			<span asp-validation-for="@Model.NewUser.Telefon" class="text-danger"></span>
		</div>

		<div class="form-group">
			<label asp-for="@Model.NewUser.PwHash" class="control-label">Kodeord</label>
			<input asp-for="@Model.NewUser.PwHash" class="form-control" type="password" />
			<span asp-validation-for="@Model.NewUser.PwHash" class="text-danger"></span>
		</div>

		<p>
			<div class="form-group">
				<input type="submit" value="Opret" class="btn btn-primary" />
			</div>
		</p>
	</form>
</div>

@if (Model.CreatedUser != null)
{
	<div class="modal fade show" id="successModal" tabindex="-1" style="display: block; background-color: rgba(0,0,0,0.5);">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">User Created Successfully!</h5>
					<button type="button" class="btn-close" onclick="window.location.href='/Index'"></button>
				</div>
				<div class="modal-body">
					<p><strong>ID:</strong> @Model.CreatedUser.Id</p>
					<p><strong>Name:</strong> @Model.CreatedUser.Name</p>
					<p><strong>Email:</strong> @Model.CreatedUser.Email</p>
					<p><strong>Telefon:</strong> @Model.CreatedUser.Telefon</p>
				</div>
				<div class="modal-footer">
					<a href="/Index" class="btn btn-primary">Go to HomePage</a>
					<a href="/User/CreateUser" class="btn btn-primary">Create Another</a>
				</div>
			</div>
		</div>
	</div>
}

@if (Model.Modal != null)
{
	<partial name="Shared/ModalViewError" model="Model.Modal" />
}

