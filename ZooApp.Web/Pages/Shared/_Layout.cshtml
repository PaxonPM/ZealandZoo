<!DOCTYPE html>
<html lang="en">
<style>
    body {
        background-image: url('Images/FlamingoBG.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: repeat;
        color: #FF2AFF;
    }

    .navbar {
        background-color: #0a0a0a;
        color: #FF2AFF;
    }

    .navbar-brand, .navbar-link, .navbar-link, .navbar-link {
        color: #FF2AFF;
    }

        .navbar-brand:hover, .navbar-link:hover {
            color: #FF2AFF;
        }

    .card {
        color: #00FFFF;
    }

    .card-header {
        color: #FF2AFF;
    }

</style>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ZealandZoo</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ZealandZoo.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        bool isGuest = Context.Session.GetString("IsGuest") == "true";
        bool isAdmin = Context.Session.GetString("IsAdmin") == "true";
        bool isStaff = Context.Session.GetString("IsStaff") == "true";
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3" style="background-color:#0a0a0a">
            <div class="container" style="background-color:#0a0a0a;">
                <a class="navbar-brand" asp-area="" asp-page="/Index">ZealandZoo</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between"  style= "background-color:#0a0a0a; color: #FF2AFF">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" style=" color: #FF2AFF" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" style=" color: #FF2AFF" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" style=" color: #FF2AFF" asp-page="/Event/Events">Events</a>
                        </li>

                        @if (!isGuest && !isAdmin && !isStaff)
                        {
                            <li class="nav-item">
                                <a class="nav-link" style=" color: #FF2AFF" asp-page="/Register/CreateGuest">Register</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" style=" color: #FF2AFF" asp-page="/Guest/GuestLogin">Login</a>
                            </li>
                        }

                        @if (isAdmin || isStaff)
                        {
                            <li class="nav-item">
                                <a class="nav-link" style=" color: #FF2AFF" asp-page="/Inventory/Inventory">Lager</a>
                            </li>
                        }

                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" style=" color: #FF2AFF" asp-page="/Event/CreateEvent">Opret Event</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" style=" color: #FF2AFF" asp-page="/staff/createstaff">Opret medarbejder</a>
                            </li>
                        }
                        @if (isGuest || isAdmin || isStaff)
                        {
                            <li class="nav-item">
                                <form method="post" asp-page="/Logout">
                                    <button type="submit" class="btn btn-link nav-link px-0" style=" color: #FF2AFF">Log ud</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container" style=" color: #FF2AFF">
            &copy; 2026 - ZealandZoo - <a asp-area="" asp-page="/admin/adminlogin">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
