@page
@model ZooApp.Web.Pages.Guest.GuestDashboardModel
<style>
    body {
        background-image: url('Images/FlamingoBG.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: repeat;
        color: #FF2AFF;
    }

    .navbar {
        background-color: #0a0a0a;
        color: #FF2AFF;
    }

    .navbar-brand, .navbar-link, .navbar-link, .navbar-link {
        color: #FF2AFF;
    }

        .navbar-brand:hover, .navbar-link:hover {
            color: #FF2AFF;
        }

    .card {
        color: #00FFFF;
    }

    .card-header {
        color: #FF2AFF;
    }

</style>
<h2>Guest Dashboard</h2>

<p>Velkommen, @HttpContext.Session.GetString("GuestUsername")!</p>

<p>Her kan du se og tilmelde dig events.</p>

<a class="btn btn-primary" style="background-color:#0a0a0a; color: #FF2AFF" asp-page="/Index">Se events</a>