@page "{id:int}"
@model ZooApp.Web.Pages.Event.DeleteEventModel
@{
    ViewData["Title"] = "Delete Event";
}

<h1>Delete Confirmation</h1>

<div class="alert alert-danger">
    <h5>Are you sure you want to delete Event - @Model.Event.Title?</h5>

    <form method="post">
        <input type="hidden" asp-for="Event.Id" />

        <button type="submit" class="btn btn-danger">Yes</button>
        <a class="btn btn-primary" asp-page="/Index">No</a>
    </form>
</div>

@if (Model.DeletedEvent != null)
{
    <div class="modal fade show" id="successModal" tabindex="-1" style="display: block; background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Event Deleted Successfully!</h5>
                </div>

                <div class="modal-body">
                    <p><strong>ID:</strong> @Model.DeletedEvent.Id</p>
                    <p><strong>Title:</strong> @Model.DeletedEvent.Title</p>
                    <p><strong>Description:</strong> @Model.DeletedEvent.Description</p>
                    <p><strong>Location:</strong> @Model.DeletedEvent.Location</p>
                </div>

                <div class="modal-footer">
                    <a href="/Index" class="btn btn-primary">Go to Homepage</a>
                </div>
            </div>
        </div>
    </div>
}