@page
@model ZooApp.Web.Pages.Guest.CreateGuestModel

<div class="container mt-4" style="max-width: 480px;">
    <h4>Opret Bruger</h4>

    @if (Model.SuccessMessage != null)
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div class="mb-3">
            <label class="form-label" asp-for="user.Name"></label>
            <input class="form-control" asp-for="user.Name" />
            <span class="text-danger" asp-validation-for="user.Name"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="user.Email"></label>
            <input class="form-control" asp-for="user.Email" type="email" />
            <span class="text-danger" asp-validation-for="user.Email"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="user.Telefon"></label>
            <input class="form-control" asp-for="user.Telefon" />
            <span class="text-danger" asp-validation-for="user.Telefon"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="user.PwHash">Adgangskode</label>
            <input class="form-control" asp-for="user.PwHash" type="password" />
            <span class="text-danger" asp-validation-for="user.PwHash"></span>
        </div>

        <div class="mb-3 form-check">
            <input class="form-check-input" asp-for="user.IsNotificationActive" type="checkbox" />
            <label class="form-check-label" asp-for="user.IsNotificationActive">Tilmeld nyhedsbrev</label>
        </div>

        <button type="submit" class="btn btn-primary">Opret Bruger</button>
    </form>
</div>


@* Include client-side validation scripts for immediate feedback *@
@* JQuery validation, watches form inputs, applies rules, show errors, prevents submission *@
@* @section Scripts {
    <partial name="_ValidationScriptsPartial" />
} *@