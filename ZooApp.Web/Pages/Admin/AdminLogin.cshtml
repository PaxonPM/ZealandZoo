@page
@model ZooApp.Web.Pages.Admin.AdminLoginModel
@{
    ViewData["Title"] = "Admin Login";
}



@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
<div class="container mt-4" style="max-width: 480px;">
    <h4>Admin Login</h4>
    <form method="post">
        <div class="mb-3">
            <label class="form-label">Brugernavn</label>
            <input class="form-control" asp-for="Username" />
            <span class="text-danger" asp-validation-for="Username"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Adgangskode</label>
            <input class="form-control" type="password" asp-for="Password" />
            <span class="text-danger" asp-validation-for="Password"></span>
        </div>
        <button class="btn btn-primary">Log ind</button>
    </form>
</div>