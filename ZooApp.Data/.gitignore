
## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
Debug/
Release/
x64/
x86/
build/
bld/
Bin/
Obj/
ZooApp.Web\Properties\launchSettings.json
ZooApp.Web/Properties/launchSettings.json
# Visual Studio cache
.vs/

# Rider / VS Code
.idea/
.vscode/

# NuGet
*.nupkg
*.snupkg
packages/
*.nuget.props
*.nuget.targets

# Logs
*.log

# Database files
*.mdf
*.ldf

# SQL Server LocalDB
*.dbmdl

# Publish
publish/
*.publishsettings

# Azure
*.azurePubxml

# Resharper
_ReSharper*/
*.DotSettings.user

# OS files
.DS_Store
Thumbs.db

# Test results
TestResults/

# Coverage
coverage/
*.coverage
*.coveragexml

# Backup files
*.bak

# Temporary files
*.tmp
*.temp

# Generated files
Generated\ Files/

# Visual Studio Code settings (optional)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json